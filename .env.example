# Discovery and YouTube upload
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_CLIENT_FILE=client_secret.json
YOUTUBE_OAUTH_TOKEN_FILE=.secrets/youtube_token.json
YOUTUBE_REGION=US
# Name from youtube_categories.json or numeric category ID, e.g. Comedy or 23
YOUTUBE_CATEGORY=
# JSON array of channel IDs that you own
OWNED_CHANNEL_IDS=[]

# AI providers
ASSEMBLYAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
SCENE_CONTEXT_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_FIDELITY=high
# Transform moderation-blocked panels into benign variants; then placeholder or fail
ART_MODERATION_FALLBACK_ENABLED=true
ART_MODERATION_FINAL_ACTION=placeholder
REFERENCE_FRAME_COUNT=6
REFERENCE_FRAME_MAX_WIDTH=1024

# Local tools and output
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
OUTPUT_DIR=output
DOWNLOAD_DIR=downloads
LOG_DIR=output/logs
LOG_LEVEL=INFO
LOG_FILENAME=clipsnstrips.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
MIN_CLIP_SECONDS=15
MAX_CLIP_SECONDS=60
HIGHLIGHT_SECONDS_PER_CANDIDATE=120
HIGHLIGHT_MIN_CANDIDATES=3
HIGHLIGHT_MAX_CANDIDATES=12
ART_SECONDS_PER_PANEL=8
ART_MIN_PANELS=3
ART_MAX_PANELS=12
