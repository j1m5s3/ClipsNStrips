# Discovery and YouTube upload
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_CLIENT_FILE=client_secret.json
YOUTUBE_OAUTH_TOKEN_FILE=.secrets/youtube_token.json
YOUTUBE_REGION=US
# Name from youtube_categories.json or numeric category ID, e.g. Comedy or 23
YOUTUBE_CATEGORY=
# JSON array of channel IDs that you own
OWNED_CHANNEL_IDS=[]

# AI providers
ASSEMBLYAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
SCENE_CONTEXT_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_FIDELITY=high
# Transform moderation-blocked panels into benign variants; then placeholder or fail
ART_MODERATION_FALLBACK_ENABLED=true
ART_MODERATION_FINAL_ACTION=placeholder
REFERENCE_FRAME_COUNT=6
REFERENCE_FRAME_MAX_WIDTH=1024
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# JSON array: first voice is narrator; remaining IDs are deterministically assigned
ELEVENLABS_VOICE_IDS=[]
ELEVENLABS_STABILITY=0.55
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.15

# Document extraction, OCR, narration, and long-form rendering
DOCUMENT_OCR_MODEL=gemini-3.6-flash
DOCUMENT_FRONT_MATTER_MAX_CHARS=20000
DOCUMENT_MAX_BYTES=104857600
DOCUMENT_MAX_PAGES=500
DOCUMENT_OCR_MIN_CHARS=40
DOCUMENT_TARGET_SECTION_WORDS=900
DOCUMENT_MAX_SECTION_WORDS=1400
DOCUMENT_WORDS_PER_PANEL=90
DOCUMENT_MIN_PANELS=1
DOCUMENT_MAX_PANELS=24
DOCUMENT_MAX_NARRATION_CHARACTERS=500000
NARRATION_PAUSE_SECONDS=0.25
NARRATION_AUDIO_LUFS=-16

# Local tools and output
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
OUTPUT_DIR=output
DOWNLOAD_DIR=downloads
LOG_DIR=output/logs
LOG_LEVEL=INFO
LOG_FILENAME=clipsnstrips.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
MIN_CLIP_SECONDS=15
MAX_CLIP_SECONDS=60
HIGHLIGHT_SECONDS_PER_CANDIDATE=120
HIGHLIGHT_MIN_CANDIDATES=3
HIGHLIGHT_MAX_CANDIDATES=12
ART_SECONDS_PER_PANEL=8
ART_MIN_PANELS=3
ART_MAX_PANELS=12
ART_SUBPANELS_PER_IMAGE=4
