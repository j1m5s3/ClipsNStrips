# Discovery and YouTube upload
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_CLIENT_FILE=client_secret.json
YOUTUBE_OAUTH_TOKEN_FILE=.secrets/youtube_token.json
YOUTUBE_REGION=US
YOUTUBE_CATEGORY=
# JSON array of channel IDs that you own
OWNED_CHANNEL_IDS=[]

# AI providers
ASSEMBLYAI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Local tools and output
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
OUTPUT_DIR=output
DOWNLOAD_DIR=downloads
MIN_CLIP_SECONDS=15
MAX_CLIP_SECONDS=60
